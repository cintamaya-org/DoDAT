# Exemple de variables d'environnement pour Cintafactory.
# Copier vers .env puis remplacer les valeurs sensibles.

# --- Application Django / Docker ---
# Nom de base utilise par Docker pour les conteneurs et volumes.
APP_NAME=cintafactory
# Port interne de l'application web.
APP_PORT=8000
# Port expose sur l'hote pour l'application web.
HOST_PORT=8101
# Module Django de configuration.
DJANGO_SETTINGS_MODULE=cintafactory.settings
# Module WSGI lance par Gunicorn.
APP_MODULE=cintafactory.wsgi:application
# Port lu par Gunicorn.
PORT=8000
# Active le mode debug Django.
DJANGO_DEBUG=True
# Cle secrete Django, obligatoire.
DJANGO_SECRET_KEY=replace-with-a-strong-secret
# Hosts autorises, separes par virgules.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines CSRF fiables, avec scheme, separees par virgules.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Lance les migrations au demarrage du conteneur.
RUN_MIGRATIONS=1
# Lance collectstatic au demarrage du conteneur.
COLLECT_STATIC=1
# UID Linux utilise dans certains conteneurs.
APP_UID=1000
# GID Linux utilise dans certains conteneurs.
APP_GID=1000

# --- Securite HTTP / cookies ---
# Force les controles de secrets forts.
DJANGO_ENFORCE_STRICT_SECRETS=0
# Force HTTPS/HSTS/cookies secure.
DJANGO_ENFORCE_STRICT_HTTP=0
# Duree HSTS en secondes.
SECURE_HSTS_SECONDS=0
# Ajoute les sous-domaines au HSTS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# Active preload HSTS.
SECURE_HSTS_PRELOAD=0
# Politique Referrer-Policy.
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
# Politique Cross-Origin-Opener-Policy.
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
# Marque le cookie session comme secure.
SESSION_COOKIE_SECURE=0
# Rend le cookie session inaccessible au JavaScript.
SESSION_COOKIE_HTTPONLY=1
# Politique SameSite du cookie session.
SESSION_COOKIE_SAMESITE=Lax
# Marque le cookie CSRF comme secure.
CSRF_COOKIE_SECURE=0
# Rend le cookie CSRF inaccessible au JavaScript.
CSRF_COOKIE_HTTPONLY=1
# Politique SameSite du cookie CSRF.
CSRF_COOKIE_SAMESITE=Lax
# Stocke le token CSRF en session.
CSRF_USE_SESSIONS=1

# --- Base de donnees ---
# Nom de la base lue par Django.
DATABASE_NAME=cintafactory
# Utilisateur DB lu par Django.
DATABASE_USER=cintafactory
# Mot de passe DB lu par Django.
DATABASE_PASSWORD=replace-with-db-password
# Host DB lu par Django.
DATABASE_HOST=db
# Port DB lu par Django.
DATABASE_PORT=5432
# Nom de la base PostgreSQL du conteneur.
POSTGRES_DB=cintafactory
# Utilisateur PostgreSQL du conteneur.
POSTGRES_USER=cintafactory
# Mot de passe PostgreSQL du conteneur.
POSTGRES_PASSWORD=replace-with-db-password
# Port PostgreSQL expose sur l'hote.
DB_HOST_PORT=5433

# --- Fichiers statiques / medias ---
# Dossier de sortie collectstatic.
DJANGO_STATIC_ROOT=/app/staticfiles
# Dossier des medias uploades.
DJANGO_MEDIA_ROOT=/app/media

# --- Email SMTP ---
# Backend email Django.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Serveur SMTP.
EMAIL_HOST=localhost
# Port SMTP.
EMAIL_PORT=25
# Identifiant SMTP.
EMAIL_HOST_USER=
# Mot de passe SMTP.
EMAIL_HOST_PASSWORD=
# Active TLS SMTP.
EMAIL_USE_TLS=0
# Active SSL SMTP.
EMAIL_USE_SSL=0
# Timeout SMTP en secondes.
EMAIL_TIMEOUT=10
# Expediteur par defaut.
DEFAULT_FROM_EMAIL=webmaster@localhost
# Expediteur des erreurs serveur.
SERVER_EMAIL=webmaster@localhost

# --- Logs / alertes ---
# Niveau global de log.
DJANGO_LOG_LEVEL=INFO
# Dossier des logs si ecriture fichier active.
DJANGO_LOG_DIR=logs
# Taille max d'un fichier log.
DJANGO_LOG_MAX_BYTES=5242880
# Nombre de fichiers log conserves.
DJANGO_LOG_BACKUP_COUNT=5
# Envoie les logs JSON vers stdout/stderr.
DJANGO_LOG_TO_STDOUT=1
# Webhook appele pour logs critiques.
LOG_CRITICAL_WEBHOOK=

# --- SeaweedFS ---
# URL interne du filer SeaweedFS.
SEAWEEDFS_FILER_URL=http://seaweedfs:8888
# URL publique du filer SeaweedFS.
SEAWEEDFS_PUBLIC_URL=http://localhost:8888
# URL publique speciale pour photos/profils.
SEAWEEDFS_PUBLIC_URL_PP=http://localhost:8888
# Prefixe de stockage dans SeaweedFS.
SEAWEEDFS_BASE_DIR=media
# Timeout SeaweedFS en secondes.
SEAWEEDFS_TIMEOUT=30
# Port master SeaweedFS expose.
SEAWEEDFS_MASTER_PORT=9333
# Port filer SeaweedFS expose.
SEAWEEDFS_FILER_PORT=8888
# Port volume SeaweedFS expose.
SEAWEEDFS_VOLUME_PORT=8080
# Cles JWT Filer distinctes pour lectures et ecritures (minimum 32 caracteres).
SEAWEEDFS_JWT_WRITE_KEY=replace-with-random-filer-write-key
SEAWEEDFS_JWT_READ_KEY=replace-with-random-filer-read-key
# Cles JWT Volume distinctes des cles Filer (minimum 32 caracteres).
SEAWEEDFS_VOLUME_JWT_WRITE_KEY=replace-with-random-volume-write-key
SEAWEEDFS_VOLUME_JWT_READ_KEY=replace-with-random-volume-read-key
# Duree de vie courte des JWT SeaweedFS, en secondes.
SEAWEEDFS_JWT_TTL_SECONDS=60

# --- ClamAV ---
# Host ClamAV.
CLAMAV_HOST=clamav
# Port ClamAV.
CLAMAV_PORT=3310
# Timeout scan ClamAV.
CLAMAV_TIMEOUT=30
# Nombre de tentatives ClamAV.
CLAMAV_RETRY_COUNT=5
# Delai entre tentatives ClamAV.
CLAMAV_RETRY_DELAY=1.0
# Dossier partage pour scan ClamAV.
CLAMAV_SCAN_DIR=/clamav_scan
# Port ClamAV expose sur l'hote.
CLAMAV_HOST_PORT=3310

# --- draw.io ---
# URL interne draw.io.
DRAWIO_BASE_URL=http://drawio:8080
# URL publique draw.io.
DRAWIO_PUBLIC_URL=http://localhost:8102
# Bibliotheques draw.io chargees.
DRAWIO_LIBS=general
# Bibliotheques custom draw.io, separees par virgules.
DRAWIO_CLIBS=
# Supprime les anciens exports draw.io.
DRAWIO_EXPORT_DELETE_OLD=1
# Port draw.io expose.
DRAWIO_HOST_PORT=8102
# Port export-server draw.io expose.
DRAWIO_EXPORT_HOST_PORT=8103

# --- LikeC4 web / exports ---
# Fichier C4 par defaut.
LIKEC4_C4_FILE=likec4/default.c4
# Port interne de l'editeur LikeC4.
LIKEC4_EDITOR_PORT=4173
# URL editeur LikeC4 vue par Django.
LIKEC4_EDITOR_URL=http://likec4:4173
# Dossier temporaire des previews LikeC4.
LIKEC4_PREVIEW_DIR=/tmp/likec4-previews
# URL metadata appelee par LikeC4.
LIKEC4_METADATA_URL=http://web:8000/diagrams/likec4/metadata/
# Token metadata LikeC4.
LIKEC4_METADATA_TOKEN=replace-with-random-likec4-metadata-token
# Token API LikeC4.
LIKEC4_API_TOKEN=replace-with-random-likec4-api-token
# Binaire LikeC4 a executer.
LIKEC4_BIN=likec4
# Sortie du webcomponent LikeC4.
LIKEC4_WEBCOMPONENT_OUTPUT=
# Timeout rendu LikeC4 en millisecondes.
LIKEC4_RENDER_TIMEOUT_MS=120000
# URL export LikeC4 appelee par Django.
LIKEC4_EXPORT_URL=http://likec4-exporter:9000/export
# Active exports LikeC4 depuis Django.
LIKEC4_EXPORT_ENABLED=1
# Supprime les anciens exports LikeC4.
LIKEC4_EXPORT_DELETE_OLD=1
# Timeout export LikeC4 cote Django.
LIKEC4_EXPORT_TIMEOUT=60
# Host du serveur exporter LikeC4.
LIKEC4_EXPORT_HOST=0.0.0.0
# Port du serveur exporter LikeC4.
LIKEC4_EXPORT_PORT=9000
# Taille max du body exporter LikeC4.
LIKEC4_EXPORT_MAX_BODY_BYTES=1048576
# Dossier temporaire des jobs export.
LIKEC4_EXPORT_TMP=
# Dossier local des exports LikeC4.
LIKEC4_EXPORT_LOCAL_DIR=/var/likec4-exports
# Format export LikeC4.
LIKEC4_EXPORT_FORMAT=png
# Vue LikeC4 exportee par defaut.
LIKEC4_EXPORT_VIEW=
# Nombre de tentatives export LikeC4.
LIKEC4_EXPORT_MAX_RETRIES=3
# Version Graphviz pour image LikeC4.
LIKEC4_GRAPHVIZ_VERSION=
# Version Playwright pour image LikeC4.
LIKEC4_PLAYWRIGHT_VER=
# Version LikeC4 pour image LikeC4.
LIKEC4_VER=
# Port dev LikeC4 expose.
LIKEC4_DEV_HOST_PORT=5173
# Port HMR LikeC4 expose.
LIKEC4_HMR_HOST_PORT=24678
# Port editeur LikeC4 expose.
LIKEC4_EDITOR_HOST_PORT=4173

# --- OAuth ---
# Timeout HTTP OAuth.
OAUTH_HTTP_TIMEOUT=10
# Autorise l'association avec un utilisateur local dont l'email correspond.
# Microsoft, Amazon et Okta refusent les utilisateurs sans compte local preexistant.
OAUTH_ALLOW_EMAIL_LINKING=1
# Limite requetes par IP et par minute.
ENDPOINT_RATE_LIMIT_PER_IP_PER_MINUTE=30
# Client ID Google OAuth.
GOOGLE_OAUTH_CLIENT_ID=
# Secret Google OAuth.
GOOGLE_OAUTH_CLIENT_SECRET=
# Tenant Microsoft OAuth.
MICROSOFT_OAUTH_TENANT_ID=common
# Client ID Microsoft OAuth.
MICROSOFT_OAUTH_CLIENT_ID=
# Secret Microsoft OAuth.
MICROSOFT_OAUTH_CLIENT_SECRET=
# Client ID Amazon OAuth.
AMAZON_OAUTH_CLIENT_ID=
# Secret Amazon OAuth.
AMAZON_OAUTH_CLIENT_SECRET=
# Domaine Okta HTTPS, sans slash final.
OKTA_OAUTH_DOMAIN=
# Client ID Okta OAuth.
OKTA_OAUTH_CLIENT_ID=
# Secret Okta OAuth.
OKTA_OAUTH_CLIENT_SECRET=
# Methode d'authentification du token Okta : client_secret_basic ou client_secret_post.
OKTA_OAUTH_TOKEN_AUTH_METHOD=client_secret_basic
# Client ID Cintamaya OAuth.
# Secret Cintamaya OAuth.

# --- Scaling / PgBouncer ---
# Port HTTP du compose scaling.
SCALE_HTTP_HOST_PORT=8200
# Taille pool PgBouncer.
PGBOUNCER_DEFAULT_POOL_SIZE=20
# Connexions client max PgBouncer.
PGBOUNCER_MAX_CLIENT_CONN=200

# --- Observabilite dev ---
# Utilisateur admin Grafana.
GRAFANA_ADMIN_USER=admin
# Mot de passe admin Grafana.
GRAFANA_ADMIN_PASSWORD=admin
# URL racine publique Grafana.
GRAFANA_ROOT_URL=http://localhost:3000
# Reseau Docker de monitoring.
APP_MONITORING_NETWORK=cintafactory-monitoring

# --- Deploiement script ---
# Environnement de deploiement: test ou prod.
ENVIRONMENT=test
# Nom de projet Docker Compose.
COMPOSE_PROJECT_NAME=cintafactory
# Binaire Docker Compose.
COMPOSE_BIN=docker compose
# Fichiers Compose additionnels.
COMPOSE_FILES=
# Lance les commandes management en deploiement.
RUN_MANAGEMENT_COMMANDS=1
# Lance collectstatic en deploiement: utilise COLLECT_STATIC defini plus haut.

# --- Variables deploy/test ---
# Port HTTP test.
TEST_HTTP_PORT=8050
# Utilise DJANGO_SECRET_KEY defini plus haut.
# Hosts autorises test: utilise DJANGO_ALLOWED_HOSTS defini plus haut.
# Origines CSRF test: utilise DJANGO_CSRF_TRUSTED_ORIGINS defini plus haut.
# URL interne draw.io test.
TEST_DRAWIO_BASE_URL=http://drawio:8080
# URL publique draw.io test.
TEST_DRAWIO_PUBLIC_URL=http://localhost:8102
# Bibliotheques draw.io test.
TEST_DRAWIO_LIBS=general
# Bibliotheques custom draw.io test.
TEST_DRAWIO_CLIBS=
# URL SeaweedFS interne test.
TEST_SEAWEEDFS_FILER_URL=http://seaweedfs:8888
# URL SeaweedFS publique test.
TEST_SEAWEEDFS_PUBLIC_URL=http://seaweedfs:8888
# Prefixe SeaweedFS test.
TEST_SEAWEEDFS_BASE_DIR=media
# Timeout SeaweedFS test.
TEST_SEAWEEDFS_TIMEOUT=30
# Host ClamAV test.
TEST_CLAMAV_HOST=clamav
# Port ClamAV test.
TEST_CLAMAV_PORT=3310
# Timeout ClamAV test.
TEST_CLAMAV_TIMEOUT=30

# --- Variables deploy/prod ---
# Port HTTP production.
PROD_HTTP_PORT=8100
# Utilise DJANGO_SECRET_KEY defini plus haut.
# Hosts autorises production: utilise DJANGO_ALLOWED_HOSTS defini plus haut.
# Origines CSRF production: utilise DJANGO_CSRF_TRUSTED_ORIGINS defini plus haut.
# URL interne draw.io production.
PROD_DRAWIO_BASE_URL=http://drawio:8080
# URL publique draw.io production.
PROD_DRAWIO_PUBLIC_URL=https://drawio.example.com
# Bibliotheques draw.io production.
PROD_DRAWIO_LIBS=general
# Bibliotheques custom draw.io production.
PROD_DRAWIO_CLIBS=
# URL SeaweedFS interne production.
PROD_SEAWEEDFS_FILER_URL=http://seaweedfs:8888
# URL SeaweedFS publique production.
PROD_SEAWEEDFS_PUBLIC_URL=http://seaweedfs:8888
# Prefixe SeaweedFS production.
PROD_SEAWEEDFS_BASE_DIR=media
# Timeout SeaweedFS production.
PROD_SEAWEEDFS_TIMEOUT=30
# Host ClamAV production.
PROD_CLAMAV_HOST=clamav
# Port ClamAV production.
PROD_CLAMAV_PORT=3310
# Timeout ClamAV production.
PROD_CLAMAV_TIMEOUT=30
