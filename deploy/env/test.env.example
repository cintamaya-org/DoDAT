# Copy to deploy/env/test.env on the server and adjust values as needed.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: override trusted CSRF origins (comma-separated, include scheme).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8050
# Only use this key for ephemeral test deployments.
DJANGO_SECRET_KEY=replace-with-a-test-secret

# draw.io endpoints (PUBLIC_URL should reflect the browser-facing host/scheme)
TEST_DRAWIO_BASE_URL=http://drawio:8080
TEST_DRAWIO_PUBLIC_URL=http://localhost:8102
# Optional: tweak palettes or preload custom libraries
# TEST_DRAWIO_LIBS=general
# TEST_DRAWIO_CLIBS=http://web:8000/static/diagrams/mes-formes.xml
# Optional: clean old draw.io PNG exports (defaults to 1)
# DRAWIO_EXPORT_DELETE_OLD=1

# SeaweedFS uploads
TEST_SEAWEEDFS_FILER_URL=http://seaweedfs:8888
TEST_SEAWEEDFS_PUBLIC_URL=http://seaweedfs:8888
TEST_SEAWEEDFS_BASE_DIR=media
TEST_SEAWEEDFS_TIMEOUT=30
# Separate test-only keys. Configure same values on SeaweedFS filer.
SEAWEEDFS_JWT_WRITE_KEY=replace-with-test-write-key-at-least-32-chars
SEAWEEDFS_JWT_READ_KEY=replace-with-test-read-key-at-least-32-chars
SEAWEEDFS_VOLUME_JWT_WRITE_KEY=replace-with-test-volume-write-key-32-chars
SEAWEEDFS_VOLUME_JWT_READ_KEY=replace-with-test-volume-read-key-32-chars
SEAWEEDFS_JWT_TTL_SECONDS=60
SEAWEEDFS_ALLOWED_ORIGINS=http://localhost:8050

# LikeC4 PNG exports (direct)
LIKEC4_EXPORT_URL=http://likec4-exporter:9000/export
LIKEC4_EXPORT_ENABLED=1
# Set both flags to 0 to pause new renders while retaining authorized source access.
LIKEC4_RENDER_ENABLED=1
# Optional LikeC4 exporter tuning
# LIKEC4_EXPORT_FORMAT=png
# LIKEC4_EXPORT_VIEW=
# LIKEC4_EXPORT_MAX_RETRIES=3
# LIKEC4_EXPORT_TIMEOUT=60
# LIKEC4_EXPORT_LOCAL_DIR=/var/likec4-exports
# LIKEC4_EXPORT_DELETE_OLD=1

# ClamAV
TEST_CLAMAV_HOST=clamav
TEST_CLAMAV_PORT=3310
TEST_CLAMAV_TIMEOUT=30

# Optional LikeC4 metadata token (callback: web + exporter only; API token: web + both brokers)
# LIKEC4_METADATA_TOKEN=replace-me
