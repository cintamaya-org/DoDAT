# Copy to deploy/env/prod.env on the server and adjust values as needed.
PROD_HTTP_PORT=8100
DJANGO_ALLOWED_HOSTS=cintarchifactory.cintamaya.com
# Optional: override trusted CSRF origins (comma-separated, include scheme).
DJANGO_CSRF_TRUSTED_ORIGINS=https://cintarchifactory.cintamaya.com
# Optional strict transport overrides (defaults are hardened when strict mode is enabled):
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# SECURE_HSTS_PRELOAD=1
DJANGO_SECRET_KEY=replace-with-a-strong-secret
# Enable static asset collection during production deployments.
COLLECT_STATIC=1

# draw.io endpoints (set the public URL to HTTPS to avoid mixed content)
PROD_DRAWIO_BASE_URL=http://drawio:8080
PROD_DRAWIO_PUBLIC_URL=https://drawio.example.com
# Optional: tweak palettes or preload custom libraries
# PROD_DRAWIO_LIBS=general
# PROD_DRAWIO_CLIBS=http://web:8050/static/diagrams/mes-formes.xml
# Optional: clean old draw.io PNG exports (defaults to 1)
# DRAWIO_EXPORT_DELETE_OLD=1

# SeaweedFS uploads
PROD_SEAWEEDFS_FILER_URL=http://seaweedfs:8888
PROD_SEAWEEDFS_PUBLIC_URL=http://seaweedfs:8888
PROD_SEAWEEDFS_BASE_DIR=media
PROD_SEAWEEDFS_TIMEOUT=30
# Separate random keys, minimum 32 characters. Configure same values on SeaweedFS filer.
SEAWEEDFS_JWT_WRITE_KEY=replace-with-strong-random-write-key
SEAWEEDFS_JWT_READ_KEY=replace-with-strong-random-read-key
SEAWEEDFS_VOLUME_JWT_WRITE_KEY=replace-with-separate-volume-write-key
SEAWEEDFS_VOLUME_JWT_READ_KEY=replace-with-separate-volume-read-key
SEAWEEDFS_JWT_TTL_SECONDS=60
SEAWEEDFS_ALLOWED_ORIGINS=https://cintarchifactory.cintamaya.com

# LikeC4 PNG exports (direct)
LIKEC4_EXPORT_URL=http://likec4-exporter:9000/export
LIKEC4_EXPORT_ENABLED=1
# Set both flags to 0 to pause new renders while retaining authorized source access.
LIKEC4_RENDER_ENABLED=1
# Optional LikeC4 exporter tuning
# LIKEC4_EXPORT_FORMAT=png
# LIKEC4_EXPORT_VIEW=
# LIKEC4_EXPORT_MAX_RETRIES=3
# LIKEC4_EXPORT_TIMEOUT=60
# LIKEC4_EXPORT_LOCAL_DIR=/var/likec4-exports
# LIKEC4_EXPORT_DELETE_OLD=1

# ClamAV
PROD_CLAMAV_HOST=clamav
PROD_CLAMAV_PORT=3310
PROD_CLAMAV_TIMEOUT=30

# Required LikeC4 tokens (callback: web + exporter only; API token: web + both brokers).
# Rotate regularly and inject from a secret manager/CI secret store.
LIKEC4_METADATA_TOKEN=replace-with-strong-random-metadata-token
LIKEC4_API_TOKEN=replace-with-strong-random-api-token
